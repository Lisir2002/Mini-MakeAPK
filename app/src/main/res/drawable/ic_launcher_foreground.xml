<?xml version="1.0" encoding="utf-8"?>
<!--
  MMA 启动图标前景层（SVG 手绘矢量）：白「包裹箱 + 向上箭头」= 把网页打包成 App。
  108x108 adaptive 网格，内容压在 18..90 的 72dp 安全区内。
  背景色见 ic_launcher_background（珊瑚粉，与设计令牌 primary 一致）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 向上箭头（出包/生成） -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,34 L54,20 M47,27 L54,20 L61,27" />
    <!-- 箱体顶面 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M38,53 L54,42 L86,42 L70,53 Z" />
    <!-- 箱体正面 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M38,53 L70,53 L70,81 L38,81 Z" />
    <!-- 箱体右侧面（略透，营造立体感） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.75"
        android:pathData="M70,53 L86,42 L86,70 L70,81 Z" />
</vector>
