    <path android:pathData="M28,0 L80,0 A28,28 0 0 1 108,28 L108,80 A28,28 0 0 1 80,108 L28,108 A28,28 0 0 1 0,80 L0,28 A28,28 0 0 1 28,0 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FFF19E97" />
                <item android:offset="1" android:color="#FFE8837B" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 向上箭头 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,34 L54,20 M47,27 L54,20 L61,27" />
