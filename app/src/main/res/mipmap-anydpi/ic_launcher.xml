<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy 启动图标回退（API 24/25，无 adaptive-icon 支持）：
  与 adaptive 同款设计的全幅矢量——圆角珊瑚底 + 白包裹箱 + 箭头。
  矢量作为应用图标在 API 21+ 由框架 VectorDrawable 直接支持。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
